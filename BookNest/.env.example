# Copy to .env in this directory: cp .env.example .env
#
# DEPLOY branch: RAILS_ENV=production + config/database.yml now require
# DB_HOST/DB_PORT/RAILS_DB_NAME/DB_USERNAME/DB_PASSWORD to be set
# (Postgres — e.g. Neon — there's no local fallback for these in
# production, the app won't boot without them). Same variable names as
# auth-service's own DB_* config for host/port/credentials — one Neon
# project's credentials work for both — but the database name is its
# own RAILS_DB_NAME, deliberately not DB_NAME: this app and auth-service
# must NOT share one database (both have a "users" table with completely
# different columns), so give this app its own database in Neon (e.g.
# booknest_shop) rather than reusing auth-service's.
RAILS_ENV=production
DB_HOST=
DB_PORT=5432
RAILS_DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# Required by Neon (and most managed Postgres providers).
DB_SSLMODE=require

# JWT_SECRET is shared between the Rails backend and the Spring Boot
# auth-service: Spring signs tokens with it, Rails verifies the signature
# with the exact same value. Generate a real one for anything beyond local
# dev, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-real-32-byte-minimum-secret-value

# This repo has no config/credentials.yml.enc, so a RAILS_MASTER_KEY
# would decrypt nothing. SECRET_KEY_BASE is what Rails actually needs in
# production — generate a real one with: openssl rand -hex 64
SECRET_KEY_BASE=change-me-to-a-real-64-byte-hex-secret

# Origins allowed to send credentialed requests to this API (see
# config/initializers/cors.rb). Fine to leave unset — the fallback
# already includes https://vscrm.github.io — but setting it explicitly
# means a stray local dev origin can't get credentialed prod access.
CORS_ALLOWED_ORIGINS=https://vscrm.github.io

# Admin/guest accounts seeded by `rails db:seed` (see backend/db/seeds.rb).
# Set your own instead of relying on the hardcoded defaults, especially
# outside local development.
ADMIN_EMAIL=admin@booknest.local
ADMIN_PASSWORD=admin12345
GUEST_EMAIL=guest@booknest.local
GUEST_PASSWORD=guest12345
