### Ignore bundler config ###
/.bundle
/vendor/bundle

### Ignore all environment files (except templates) ###
.env
!.env.example


### Ignore all default key files ###
/config/master.key
/config/credentials/*.key

### Ignore all logfiles and tempfiles ###
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/logs/

### Ignore pidfiles ###
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

### Ignore storage (uploaded files in development/test, ActiveStorage) ###
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

### User-uploaded files served from public (covers, etc.) ###
/public/uploads/

### Generated Swagger/API docs output (if regenerated, not source) ###
/public/docs/

### Ignore assets ###
/node_modules
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

### Ignore master key / credentials for all environments ###
/config/credentials/production.key

### Ignore database files ###
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-*

### RSpec / test artifacts ###
/spec/examples.txt
/coverage/

### Ignore Byebug command history ###
.byebug_history

### Ruby version managers (keep the project's own .ruby-version, ignore local overrides) ###
/.rvmrc
/.rbenv-version

### IDE ###
.idea/
.vscode/

### OS ###
.DS_Store
Thumbs.db
