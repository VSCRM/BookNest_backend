# Copy to .env in this directory: cp .env.example .env
#
# DEPLOY branch: these defaults target the deployed setup — frontend on
# GitHub Pages (https://vscrm.github.io/BookNest), backend on Render,
# database on Neon. For local `npm run dev` / docker-compose work, use
# the `main` branch's .env.example instead (or override these values).

# ─── Server ──────────────────────────────────────────────────────────────
SERVER_PORT=9000

# ─── Database (PostgreSQL) ─────────────────────────────────────────────
# Point these at your own Postgres instance, or use the docker-compose.yml
# in this directory to spin up a local one: `docker compose up -d auth_postgres`
DB_HOST=localhost
DB_PORT=5433
DB_NAME=booknest_auth
# Only used by the LOCAL docker-compose "backend" container, where Rails
# and auth-service share one environment block — without a name distinct
# from DB_NAME above, Rails would silently write its tables into
# auth-service's database instead of its own. Not used when Rails runs as
# its own separate deployment (see BookNest/.env.example) — there it's
# just DB_NAME, since there's no name collision to avoid.
RAILS_DB_NAME=booknest_shop
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Required by managed Postgres providers (e.g. Neon) in production; local
# Postgres containers don't speak SSL, so keep this "disable" for local dev.
# Required by Neon (and most managed Postgres) in production.
DB_SSLMODE=require

# Google OAuth2 — register an app at https://console.cloud.google.com/apis/credentials
# (APIs & Services -> Credentials -> Create OAuth client ID -> Web application)
# Authorized redirect URI to register there:
#   http://localhost:9000/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32+ character shared secret used to sign JWTs. MUST be identical to the
# JWT_SECRET the Rails backend uses to verify tokens. Generate a real one
# with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-real-32-byte-minimum-secret-value

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Where to send the browser after a successful Google login.
FRONTEND_URL=https://vscrm.github.io/BookNest

# Comma-separated list of origins allowed to send credentialed requests to
# this service. Fine to leave unset — the code's own fallback already
# includes https://vscrm.github.io — but setting it explicitly here means
# a stray local dev origin can't accidentally get credentialed access to
# the production service.
CORS_ALLOWED_ORIGINS=https://vscrm.github.io

# Must be true in any deployment served over HTTPS.
COOKIE_SECURE=true
# Frontend (GitHub Pages) and this service (Render) are different
# domains, so this MUST be None — Lax silently stops being sent on
# cross-site fetch/XHR requests. None requires COOKIE_SECURE=true above
# (browsers reject SameSite=None without Secure).
COOKIE_SAME_SITE=None

# Kafka broker this service publishes audit/domain events to
# (auth.user-registered, auth.user-logged-in, auth.login-failed).
# Matches the "kafka" service in the root docker-compose.yml.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Admin account auto-seeded on startup (see AdminSeeder). Keep the SAME
# values as ADMIN_EMAIL / ADMIN_PASSWORD in BookNest/backend's .env, so
# both services agree on who the admin is.
ADMIN_EMAIL=admin@booknest.local
ADMIN_PASSWORD=admin12345
